# Copy to .env and fill in. .env is gitignored.

# Freesound API — get a key at https://freesound.org/apiv2/apply
FREESOUND_KEY=

# Hugging Face token (write scope) for push_to_hub — https://huggingface.co/settings/tokens
HF_TOKEN=

# HF repo id to publish the fine-tuned adapter to, e.g. your-username/crate-clap-lora
HF_MODEL_REPO=
